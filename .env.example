# P6VC — local DEV configuration & credentials: committed SCHEMA (team-shared SSOT).
#
# How this works (reconciles ".env as team SSOT" with "never commit secrets"):
#   * THIS file (.env.example) is committed = the single source of truth for the config
#     STRUCTURE: every key name, its purpose, and non-secret defaults. The whole team
#     shares it through git, so everyone knows exactly which variables exist.
#   * The actual `.env` (gitignored) holds the secret VALUES per environment/developer.
#     Copy this file to `.env` and fill the blanks from the team's SECURE channel
#     (password manager / encrypted vault / owner-provided secret store) — NOT via git,
#     chat logs, or screenshots. `.env` must never be committed.
#   * Loader: backend/gas/scripts/load-env.mjs walks up from cwd to the repo root `.env`.
#     Existing environment variables always win; blank values are skipped.
#
# Rule: no real passwords, session tokens, bridge keys, or personal data in ANY committed file.

# --- Public runtime endpoints (non-secret; mirrored in frontend/.env.example) ---
P6VC_GAS_EXEC_URL=https://script.google.com/macros/s/AKfycby15c-Aux2za0BuedeIYni8-tc6rkf9ZVNmw-6ZMTgPvG9SvFjuQVSzNoMouiMhqTmxrA/exec
P6VC_WORKER_FRONTEND_URL=https://p6vc-api-test-console.thaipoliceregion6.workers.dev/api/frontend
P6VC_FRONTEND_ORIGIN=https://idev006.github.io

# --- Synthetic DEV batch markers (non-secret; used by live verification runners) ---
P6VC_BATCH_PREFIX=ฑฆ
P6VC_BATCH_EXPECTED=10

# --- Owner-authorization guards (FAIL-CLOSED by default; uncomment ONLY with explicit owner approval) ---
# Enables owner-authorized synthetic DEV write runners (regression / approval E2E / positive control).
# P6VC_ALLOW_OWNER_DEV_WRITES=RUN_SYNTHETIC_OWNER_DEV
# Enables the bot-executable gated DEV clean-init reset (Mode A). Synthetic DEV only.
# P6VC_ALLOW_DEV_RESET=RUN_SYNTHETIC_DEV_RESET

# --- DEV credentials (SECRET — fill in `.env` ONLY; share via secure vault; NEVER commit) ---
# Automation SYSTEM_ADMIN (+ REGISTRATION_ADMIN) used by live suites and DEV maintenance.
P6VC_ADMIN_USER=
P6VC_ADMIN_PASS=
# Test principal used by run-live-owner-dev-regression / run-live-api-suite.
P6VC_TEST_USERNAME=
P6VC_TEST_PASSWORD=