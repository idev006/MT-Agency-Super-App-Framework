{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "p6vc-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/vehicle-contact/frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "p6vc-frontend-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/vehicle-contact/frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174,
      "env": {
        "VITE_UI_PREVIEW": "true"
      }
    }
  ]
}