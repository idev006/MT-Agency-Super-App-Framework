{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "p6vc-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/vehicle-contact/frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "p6vc-frontend-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/vehicle-contact/frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174,
      "env": {
        "VITE_UI_PREVIEW": "true"
      }
    },
    {
      "name": "p6vc-core-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/vehicle-contact/backend/core",
        "run",
        "dev"
      ],
      "port": 8787,
      "autoPort": false
    },
    {
      "name": "p6vc-frontend-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/vehicle-contact/frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175,
      "env": {
        "VITE_CORE_API_URL": "http://localhost:8787/api/frontend"
      },
      "autoPort": false
    }
  ]
}
