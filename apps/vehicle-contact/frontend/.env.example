# Public runtime configuration. Never put passwords, session tokens or bridge keys here.
# Set this to the output of: node ../../../scripts/print-core-frontend-url.mjs
VITE_CORE_API_URL=

# Use / locally. Set the repository subpath when the build is integrated into GitHub Pages.
VITE_BASE_PATH=/

# Local visual QA only. Ignored by production builds because it also requires import.meta.env.DEV.
VITE_UI_PREVIEW=false
