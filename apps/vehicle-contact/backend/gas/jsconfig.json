{
  "//": "Editor/LSP only (cross-file go-to-definition, find-references). Not pushed to GAS: clasp rootDir is dist/.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "checkJs": false,
    "allowJs": true
  },
  "include": ["src/**/*.js", "tests/**/*.mjs", "tests/**/*.js", "scripts/**/*.mjs", "scripts/**/*.js", "../core/src/**/*.mjs"],
  "exclude": ["node_modules", "dist", "test-results"]
}
